{
  "expo": {
    "name": "KushRewards SA",
    "slug": "kushrewards-sa",
    "scheme": "kushrewards",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "za.co.kushrewards.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "KushRewards uses your location only on your phone to sort venues by distance. It is never sent to us or shared with venues.",
        "NSPhotoLibraryUsageDescription": "Choose a venue logo to upload (admin only).",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "za.co.kushrewards.app",
      "versionCode": 1,
      "permissions": [
        "ACCESS_COARSE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "KushRewards uses your location only on your phone to sort venues by distance. It is never sent to us or shared with venues."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a venue logo to upload (admin only).",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://kushrewards.online/api",
      "googleWebClientId": "",
      "googleIosClientId": "",
      "googleAndroidClientId": "",
      "supportEmail": "support@kushrewards.online",
      "privacyUrl": "https://kushrewards.online/privacy",
      "termsUrl": "https://kushrewards.online/terms",
      "communityRulesUrl": "https://kushrewards.online/community-rules",
      "deleteAccountUrl": "https://kushrewards.online/delete-account",
      "listedStoreTypes": [
        "dispensary",
        "club",
        "lounge"
      ]
    }
  }
}
