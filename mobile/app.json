{
  "expo": {
    "name": "KushRewards SA",
    "slug": "kush-rewards",
    "scheme": "kushrewards",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "za.co.kushrewards.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "KushRewards uses your location to show the venues closest to you and how far away they are. It stays on your phone and is never shared with us or with venues.",
        "NSPhotoLibraryUsageDescription": "Choose a venue logo to upload (admin only).",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "za.co.kushrewards.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d1611"
      }
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "KushRewards uses your location to show the venues closest to you and how far away they are. It stays on your phone and is never shared with us or with venues.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a venue logo to upload (admin only).",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0d1611"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://kushrewards.online/api",
      "googleWebClientId": "",
      "googleIosClientId": "",
      "googleAndroidClientId": "",
      "supportEmail": "support@kushrewards.online",
      "privacyUrl": "https://kushrewards.online/privacy",
      "termsUrl": "https://kushrewards.online/terms",
      "communityRulesUrl": "https://kushrewards.online/community-rules",
      "deleteAccountUrl": "https://kushrewards.online/delete-account",
      "listedStoreTypes": [
        "dispensary",
        "club",
        "lounge",
        "dispensary",
        "club",
        "lounge"
      ],
      "eas": {
        "projectId": "06e8a394-0589-45aa-9578-2ae83ed410c2"
      }
    },
    "owner": "khuphukiles-team",
    "icon": "./assets/icon.png",
    "backgroundColor": "#0d1611"
  }
}
