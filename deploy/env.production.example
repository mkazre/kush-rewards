# Copy to ~/kushrewards_app/.env on the server (cPanel File Manager) and fill in the blanks.
# Never commit the real file: the GitHub repository is public.

APP_NAME=KushRewards
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://kushrewards.online
APP_TIMEZONE=UTC

LOG_CHANNEL=single
LOG_LEVEL=warning

# cPanel → MySQL Databases: create a database and user, give the user ALL PRIVILEGES.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Demo venues and reviews are added once, the first time the database is empty.
# Set to false before launch (and hide or delete the demo venues in Admin).
SEED_DEMO=true

# Promoted to admin automatically (within a minute) after they sign up on the website.
ADMIN_EMAILS=

SUPPORT_EMAIL=support@kushrewards.online

# Google sign-in. Leave empty until you have created the OAuth clients (docs/DEPLOYMENT.md).
GOOGLE_WEB_CLIENT_ID=
# Every client ID whose tokens we accept: web, iOS, Android (comma-separated).
GOOGLE_CLIENT_IDS=

# Sign in with Apple: the iOS bundle ID.
APPLE_AUDIENCES=za.co.kushrewards.app
